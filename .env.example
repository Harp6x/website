# ─── Sanity CMS (required) ───
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token

# ─── YouTube Data API v3 (optional) ───
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_HARSH6X=your_channel_id
YOUTUBE_CHANNEL_JIMNYRUNS=your_channel_id

# ─── Instagram Graph API (optional) ───
INSTAGRAM_ACCESS_TOKEN=your_access_token
INSTAGRAM_USER_HARSH6X=your_user_id
INSTAGRAM_USER_THEREGOESUDDIP=your_user_id
INSTAGRAM_USER_JIMNYRUNS=your_user_id
